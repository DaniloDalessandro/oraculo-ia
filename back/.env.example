# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Deixe DB_ENGINE em branco (ou remova) para usar SQLite em desenvolvimento
DB_ENGINE=postgresql
DB_NAME=oraculo
DB_USER=oraculo
DB_PASSWORD=oraculo
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (cache) ────────────────────────────────────────────────────────────
# Em Docker: redis://oraculo-redis:6379/0
# Em dev local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ─── DeepSeek API (LLM do agente) ─────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1

# ─── Logging ──────────────────────────────────────────────────────────────────
AI_AGENT_LOG_LEVEL=INFO
