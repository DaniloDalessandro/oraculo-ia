# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Prova de conceito: pipeline multiagente (supervisor) de geracao de SQL
# false = caminho deterministico atual | true = supervisor + entity_resolver + sql_writer
USE_MULTI_AGENT_SQL=false
